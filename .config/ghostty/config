clipboard-trim-trailing-spaces = false
shell-integration-features = no-title
window-colorspace = display-p3
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
theme = "dark:Alien Blood,light:Catppuccin Latte"
font-size = 16
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-thicken = true
# font-family = "JetBrainsMono Nerd Font Mono"
font-codepoint-map = U+4E00-U+9FFF,U+3400-U+4DBF,U+3000-U+303F,U+FF00-U+FFEF=LXGW WenKai Mono
macos-titlebar-style = transparent
macos-icon = custom-style
macos-icon-ghost-color = #9EDF9C
macos-icon-screen-color = #000
macos-icon-frame = beige
mouse-hide-while-typing = true

# It doesn't look great
# background-opacity = 0.95
# background-blur = true

keybind = ctrl+enter=text:gst\n
keybind = shift+enter=text:\n
# shift+space would send CSI-u `ESC[32;2u`, which zsh vi-mode reads as
# ESC + vi commands (`u` = undo → wipes the line when typing `: ` fast)
keybind = shift+space=text:\x20
# same story: shift+backspace sends `ESC[127;2u` → wipes the line via vi undo
keybind = shift+backspace=text:\x7f
# Programmer Dvorak maps physical Digit3 and Digit4 to { and }.
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+{=previous_tab
keybind = cmd+}=next_tab

# Multiplexing = Ghostty's native macOS shortcuts (no custom binds, no Leader Key):
#   cmd+d split right · cmd+shift+d split down · cmd+t new tab
#   cmd+opt+arrows move between splits · cmd+{ / } prev/next tab
#   cmd+shift+enter zoom split · cmd+w close · cmd+1..8 goto tab
# Sessions = zmx (persistence): names come from the working directory.
window-save-state = always
command = /Users/posva/.config/zsh/bin/ghostty-zmx

# custom-shader = ./shaders/cursor-blaze.glsl
# custom-shader = ./shaders/inside-the-matrix.glsl
custom-shader = ./shaders/cursor-matrix.glsl
# custom-shader = ./shaders/matrix-hallway.glsl
# custom-shader = ./shaders/bloom.glsl

custom-shader-animation = always
